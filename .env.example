# Hospital Patient Data Analysis System
# Environment Configuration Template
# Copy this file to .env and configure your local MySQL credentials

# Flask Configuration
SECRET_KEY=hospital-patient-analytics-secure-key-2026
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=hospital_analytics

# Test Database Configuration (Used by pytest)
TEST_MYSQL_DB=hospital_analytics_test
